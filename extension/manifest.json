{
  "manifest_version": 3,
  "name": "Miru Importer",
  "version": "0.1.0",
  "description": "Importe des animes depuis AniList, MAL et Crunchyroll vers Miru",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["https://anilist.co/*", "https://myanimelist.net/*", "https://www.crunchyroll.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://anilist.co/anime/*/*"],
      "js": ["content-scripts/anilist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myanimelist.net/anime/*/*"],
      "js": ["content-scripts/mal.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/series/*/*",
        "https://www.crunchyroll.com/*/series/*/*"
      ],
      "js": ["content-scripts/crunchyroll.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://anilist.co/*",
    "https://myanimelist.net/*",
    "https://www.crunchyroll.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "miru-importer@guillaumedelre",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
